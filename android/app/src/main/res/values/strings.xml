<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">MyRemote</string>

    <!-- Pairing screen -->
    <string name="pairing_title">Pair with your Mac</string>
    <string name="pairing_body">Open the MyRemote agent on your Mac, show the pairing QR code and scan it here. Phone and Mac must be on the same Wi-Fi network.</string>
    <string name="pairing_scan">Scan QR code</string>
    <string name="pairing_or">or</string>
    <string name="pairing_link_label">Pairing link</string>
    <string name="pairing_link_placeholder" translatable="false">myremote://pair?…</string>
    <string name="pairing_connect">Pair</string>
    <string name="pairing_scanner_unavailable">The QR scanner is not available on this device right now. Paste the pairing link instead.</string>

    <!-- Pairing link errors, one per reason -->
    <string name="pairing_error_not_a_uri">That is not a pairing link. A pairing link starts with myremote://pair</string>
    <string name="pairing_error_wrong_scheme">That is a “%1$s” link, not a MyRemote pairing link.</string>
    <string name="pairing_error_wrong_action">That is a MyRemote link, but not a pairing link.</string>
    <string name="pairing_error_missing">The pairing link is incomplete: “%1$s” is missing.</string>
    <string name="pairing_error_version">This pairing link uses protocol version “%1$s”, but this app supports version 1. Update the app or the Mac agent.</string>
    <string name="pairing_error_host">The Mac\'s address in the pairing link is not valid.</string>
    <string name="pairing_error_port">The port in the pairing link is not valid. It must be between 1 and 65535.</string>
    <string name="pairing_error_id">The agent ID in the pairing link is not valid.</string>
    <string name="pairing_error_name">The Mac\'s name in the pairing link is missing or not valid.</string>
    <string name="pairing_error_fp">The certificate fingerprint in the pairing link is not valid. It must be 64 hexadecimal characters.</string>
    <string name="pairing_error_token">The pairing token in the link is not valid.</string>

    <!-- Connection status -->
    <string name="status_disconnected">Disconnected</string>
    <string name="status_connecting">Connecting…</string>
    <string name="status_connected">Connected</string>
    <string name="status_retry_network">Can\'t reach the Mac. Retrying…</string>
    <string name="status_retry_heartbeat">The Mac stopped responding. Reconnecting…</string>
    <string name="status_retry_closed">The Mac closed the connection. Reconnecting…</string>
    <string name="status_retry_handshake">The Mac did not answer. Retrying…</string>
    <string name="status_unauthorized">Pairing is no longer valid</string>
    <string name="status_version">Incompatible Mac agent</string>
    <string name="status_pin_mismatch">Not the paired Mac</string>

    <!-- Profiles -->
    <string name="profile_youtube" translatable="false">YouTube</string>
    <string name="profile_netflix" translatable="false">Netflix</string>
    <string name="profile_appletv" translatable="false">Apple TV</string>
    <string name="profile_generic">Other app</string>

    <!-- Banners -->
    <string name="banner_accessibility_title">The Mac will ignore this remote</string>
    <string name="banner_accessibility_body">The MyRemote agent has no Accessibility permission. On the Mac, open System Settings → Privacy &amp; Security → Accessibility and allow MyRemote.</string>
    <string name="banner_unauthorized_body">The Mac rejected this phone. Pairing was probably reset on the Mac. Pair again to continue.</string>
    <string name="banner_version_body">The Mac agent does not support this app\'s protocol version. Update the app and the Mac agent.</string>
    <string name="banner_pin_body">The computer at the Mac\'s address presented a different certificate, so nothing was sent to it. If the Mac agent was reinstalled, pair again.</string>
    <string name="action_pair_again">Pair again</string>
    <string name="action_retry">Retry</string>

    <!-- Remote controls (also used as accessibility labels) -->
    <string name="control_play_pause">Play or pause</string>
    <string name="control_seek_back">Seek backward</string>
    <string name="control_seek_forward">Seek forward</string>
    <string name="control_mute">Mute</string>
    <string name="control_subtitles">Subtitles</string>
    <string name="control_fullscreen">Fullscreen</string>
    <string name="control_previous">Previous</string>
    <string name="control_next">Next</string>
    <string name="control_skip">Skip</string>
    <string name="control_volume_up">Volume up</string>
    <string name="control_volume_down">Volume down</string>
    <string name="control_back">Back</string>
    <string name="control_backspace">Backspace</string>
    <string name="control_keyboard">Type text</string>
    <string name="trackpad_label">Trackpad</string>
    <string name="trackpad_hint">Tap to click · two fingers to scroll · two-finger tap for right click</string>

    <!-- Text entry -->
    <string name="text_title">Type on the Mac</string>
    <string name="text_field_label">Text</string>
    <string name="text_send">Send</string>
    <string name="text_enter">Enter</string>
    <string name="text_close">Close</string>

    <!-- Menu -->
    <string name="menu_more">More options</string>
    <string name="menu_forget">Forget this Mac</string>
    <string name="forget_title">Forget “%1$s”?</string>
    <string name="forget_body">This phone will stop controlling the Mac until you scan its pairing QR code again.</string>
    <string name="forget_confirm">Forget</string>
    <string name="cancel">Cancel</string>

    <!-- Command feedback -->
    <string name="feedback_unsupported">Not available in %1$s. Use the trackpad instead.</string>
    <string name="feedback_accessibility">The Mac agent has no Accessibility permission, so nothing happened.</string>
    <string name="feedback_bad_request">The Mac agent did not understand this command.</string>
    <string name="feedback_rejected">The Mac refused the command (%1$s).</string>
    <string name="feedback_timeout">No response from the Mac.</string>
    <string name="feedback_not_connected">Not connected to the Mac.</string>
</resources>
